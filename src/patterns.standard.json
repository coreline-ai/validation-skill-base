{
  "version": "1.1.0",
  "mode": "standard",
  "description": "Standard security patterns (29) - Essential + API keys, secrets, suspicious domains, obfuscation",
  "failure_thresholds": {
    "critical": 0,
    "high": 2
  },
  "patterns": [
    {
      "id": "dangerous_eval_dollar",
      "name": "eval with variable",
      "severity": "HIGH",
      "category": "security",
      "regex": "eval\\s*\\(\\s*\\$",
      "description": "Dangerous eval with variable expansion"
    },
    {
      "id": "dangerous_exec_dollar",
      "name": "exec with variable",
      "severity": "HIGH",
      "category": "security",
      "regex": "exec\\s*\\(\\s*\\$",
      "description": "Dangerous exec with variable expansion"
    },
    {
      "id": "dangerous_system_dollar",
      "name": "system with variable",
      "severity": "HIGH",
      "category": "security",
      "regex": "(os\\.)?system\\s*\\(\\s*\\$",
      "description": "Dangerous system call with variable"
    },
    {
      "id": "dangerous_rm_root",
      "name": "rm -rf from root",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "rm\\s+-rf\\s+/",
      "description": "Dangerous command: rm -rf from root directory"
    },
    {
      "id": "dangerous_curl_pipe",
      "name": "curl | bash",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "curl\\s+[^|]*\\|\\s*bash",
      "description": "Piping curl to bash is dangerous"
    },
    {
      "id": "dangerous_wget_pipe",
      "name": "wget | sh",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "wget\\s+[^|]*\\|\\s*sh",
      "description": "Piping wget to shell is dangerous"
    },
    {
      "id": "dangerous_dd_dev_zero",
      "name": "dd to /dev/sda",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "dd\\s+.*of=/dev/sd[a-z]",
      "description": "dd to disk can destroy data"
    },
    {
      "id": "file_unlink_root",
      "name": "unlink from root",
      "severity": "HIGH",
      "category": "security",
      "regex": "(unlink|rmdir)\\s*\\(\\s*['\"]/",
      "description": "File deletion from root path"
    },
    {
      "id": "file_shutil_rmtree_root",
      "name": "shutil.rmtree from root",
      "severity": "HIGH",
      "category": "security",
      "regex": "shutil\\.(rmtree|delete_tree)\\s*\\(\\s*['\"]/",
      "description": "Directory deletion from root path"
    },
    {
      "id": "owasp_llm01_prompt_inject",
      "name": "Prompt Injection Pattern",
      "severity": "HIGH",
      "category": "owasp",
      "regex": "(?im)^(?!\\s*(?:(?:#|//|/\\*|\\*)\\s|['\\\"]{1,3}))(?!\\s*do\\s+not\\b)\\s*(?:[-+]\\s+|>\\s*|\\d+\\.\\s+)?(?:ignore|forget|disregard|override|bypass)\\b.{0,100}\\b(?:instructions?|prompt|system)\\b",
      "description": "Possible prompt injection pattern"
    },
    {
      "id": "owasp_llm02_insecure_output",
      "name": "Insecure Output Handling",
      "severity": "HIGH",
      "category": "owasp",
      "regex": "(?im)^(?!\\s*(?:(?:#|//|/\\*|\\*|>|-|\\d+\\.)\\s|['\\\"]{1,3}))[^\n]*\\b(?:eval|exec|os\\.system|system)\\s*\\(",
      "description": "Direct execution of LLM output"
    },
    {
      "id": "malware_keylogger",
      "name": "Keylogger Keyword",
      "severity": "CRITICAL",
      "category": "malicious",
      "regex": "(?i)\\b(keylogger|keystroke[_ -]?log|key[_ -]?stroke)",
      "description": "Keylogger-related keyword detected"
    },
    {
      "id": "malware_stealer",
      "name": "Stealer Keyword",
      "severity": "CRITICAL",
      "category": "malicious",
      "regex": "(stealer|info.?steal|data.?steal)",
      "description": "Stealer-related keyword detected"
    },
    {
      "id": "malware_ransomware",
      "name": "Ransomware Keyword",
      "severity": "CRITICAL",
      "category": "malicious",
      "regex": "ransomware|encrypt.?file|file.?encrypt",
      "description": "Ransomware-related keyword detected"
    },
    {
      "id": "malware_trojan",
      "name": "Trojan Keyword",
      "severity": "CRITICAL",
      "category": "malicious",
      "regex": "(trojan|backdoor|rootkit|botnet)",
      "description": "Trojan/malware keyword detected"
    },
    {
      "id": "api_key_openai",
      "name": "OpenAI API Key",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "sk-[a-zA-Z0-9]{48}",
      "description": "OpenAI API key detected in code"
    },
    {
      "id": "api_key_anthropic",
      "name": "Anthropic API Key",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "sk-ant-[a-zA-Z0-9]{95}",
      "description": "Anthropic API key detected in code"
    },
    {
      "id": "api_key_generic",
      "name": "Generic API Key",
      "severity": "HIGH",
      "category": "security",
      "regex": "api[_-]?key\\s*=\\s*['\"][^'\"]{10,}['\"]",
      "description": "Generic API key assignment found"
    },
    {
      "id": "secret_generic",
      "name": "Generic Secret",
      "severity": "HIGH",
      "category": "security",
      "regex": "secret\\s*=\\s*['\"][^'\"]{10,}['\"]",
      "description": "Secret assignment found"
    },
    {
      "id": "token_generic",
      "name": "Generic Token",
      "severity": "HIGH",
      "category": "security",
      "regex": "token\\s*=\\s*['\"][^'\"]{10,}['\"]",
      "description": "Token assignment found"
    },
    {
      "id": "password_hardcoded",
      "name": "Hardcoded Password",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "(?i)password\\s*=\\s*['\\\"](?!placeholder\\b|example(?:123)?\\b|changeme\\b|dummy\\b|sample\\b|test\\b|your[_-]?password\\b)[^'\\\"]{8,}['\\\"]",
      "description": "Hardcoded password detected"
    },
    {
      "id": "aws_access_key",
      "name": "AWS Access Key",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "AWS_ACCESS_KEY_ID\\s*=\\s*['\"]?[A-Z0-9]{20}['\"]?",
      "description": "AWS access key detected"
    },
    {
      "id": "aws_secret_key",
      "name": "AWS Secret Key",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "AWS_SECRET_ACCESS_KEY\\s*=\\s*['\"]?[A-Za-z0-9+/]{40}['\"]?",
      "description": "AWS secret key detected"
    },
    {
      "id": "github_token",
      "name": "GitHub Token",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "gh[pousr]_[a-zA-Z0-9]{36,255}",
      "description": "GitHub personal access token detected"
    },
    {
      "id": "private_key",
      "name": "Private Key",
      "severity": "CRITICAL",
      "category": "security",
      "regex": "-----BEGIN [A-Z]+ PRIVATE KEY-----",
      "description": "Private key detected"
    },
    {
      "id": "network_evil_domain",
      "name": "Suspicious domain",
      "severity": "HIGH",
      "category": "security",
      "regex": "https?://[\\w-]*\\.(evil|malicious|hack|bad|steal)[\\w-]*\\.",
      "description": "Suspicious domain name detected"
    },
    {
      "id": "network_ip_url",
      "name": "Direct IP address URL",
      "severity": "HIGH",
      "category": "security",
      "regex": "https?://(?!(?:127\\.0\\.0\\.1|localhost)(?:[:/]|$))(?!(?:10\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[01])\\.))(?:\\d{1,3}\\.){3}\\d{1,3}(?::\\d+)?",
      "description": "Direct IP address URL (bypasses domain checks)"
    },
    {
      "id": "obfuscation_base64_command",
      "name": "base64 with decode/exec",
      "severity": "HIGH",
      "category": "security",
      "regex": "(base64|b64decode|atob|btoa).*(eval|exec|system|\\$\\(|popen)",
      "description": "Base64 decode followed by execution"
    },
    {
      "id": "obfuscation_hex_decode",
      "name": "Hex decode pattern",
      "severity": "HIGH",
      "category": "security",
      "regex": "(\\\\x[0-9a-fA-F]{2}){5,}",
      "description": "Multiple hex escape sequences (obfuscation)"
    }
  ]
}
