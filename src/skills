#!/bin/bash
# ~/.local/bin/skills
#
# CLI 래퍼: npx skills 명령을 가로채서 검증 후 설치

set -euo pipefail

# =============================================================================
# 설정
# =============================================================================

VALIDATOR_HOME="$HOME/.claude/skill-validator"
VALIDATOR="$VALIDATOR_HOME/validator.sh"
DEFAULT_SKILLS_CLI_VERSION="1.4.6"
SKILLS_CLI_VERSION="${SKILLS_CLI_VERSION:-$DEFAULT_SKILLS_CLI_VERSION}"
SKILLS_CLI_PACKAGE="skills@${SKILLS_CLI_VERSION}"
SKILLS_CLI_TARBALL="${SKILLS_CLI_TARBALL:-}"
SKILLS_CLI_TARBALL_SHA256="${SKILLS_CLI_TARBALL_SHA256:-}"

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# =============================================================================
# 로그 함수
# =============================================================================

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
log_step() { echo -e "${BLUE}[→]${NC} $*"; }

validate_skills_cli_version() {
    [[ "$SKILLS_CLI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]
}

sha256_file() {
    local target="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$target" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$target" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 -r "$target" | awk '{print $1}'
    else
        log_error "No SHA-256 utility found (sha256sum, shasum, or openssl required)"
        return 1
    fi
}

run_skills_cli() {
    if [ -n "$SKILLS_CLI_TARBALL" ]; then
        if [ ! -f "$SKILLS_CLI_TARBALL" ]; then
            log_error "SKILLS_CLI_TARBALL not found: $SKILLS_CLI_TARBALL"
            return 1
        fi

        if [ -n "$SKILLS_CLI_TARBALL_SHA256" ]; then
            local actual_sha256
            actual_sha256=$(sha256_file "$SKILLS_CLI_TARBALL") || return 1

            if [ "$actual_sha256" != "$SKILLS_CLI_TARBALL_SHA256" ]; then
                log_error "SKILLS_CLI_TARBALL_SHA256 mismatch"
                log_error "Expected: $SKILLS_CLI_TARBALL_SHA256"
                log_error "Actual:   $actual_sha256"
                return 1
            fi
        fi

        npx --yes --package "$SKILLS_CLI_TARBALL" skills "$@"
        return $?
    fi

    if ! validate_skills_cli_version; then
        log_error "Invalid SKILLS_CLI_VERSION: $SKILLS_CLI_VERSION"
        log_error "Use an exact semver such as ${DEFAULT_SKILLS_CLI_VERSION}, not tags like 'latest'."
        return 1
    fi

    npx --yes --package "$SKILLS_CLI_PACKAGE" skills "$@"
}

normalize_path() {
    local path="$1"

    case "$path" in
        "~/"*)
            path="$HOME/${path#"~/"}"
            ;;
    esac

    if [ -d "$path" ]; then
        path=$(cd "$path" 2>/dev/null && pwd -P) || true
    elif [ -e "$path" ]; then
        local parent_dir
        parent_dir=$(cd "$(dirname "$path")" 2>/dev/null && pwd -P) || true
        if [ -n "${parent_dir:-}" ]; then
            path="$parent_dir/$(basename "$path")"
        fi
    fi

    printf '%s' "$path"
}

# =============================================================================
# 도움말
# =============================================================================

show_help() {
    cat << 'EOF'
Skills - CLI wrapper with security validation

USAGE:
    skills <command> [options]

COMMANDS:
    add <skill-path>       Add a new skill with security validation
    validate <skill-name>  Validate an installed skill
    audit                  Audit all installed skills
    check <skill-name>     Check skill with detailed report
    remove <skill-name>    Remove a skill
    list                   List installed skills
    update                 Check validation status, then update all skills
    help, --help          Show this help message

OPTIONS:
    --mode=essential       Essential validation (15 patterns) - Fast
    --mode=standard        Standard validation (29 patterns) - Default
    --mode=thorough        Thorough validation (58 patterns) - Comprehensive
    --force                 Force install even if validation fails (USE WITH CAUTION)
    --skip-validation      Skip security validation (NOT RECOMMENDED)
    --report                Show detailed report (for check command)

EXAMPLES:
    skills add mattpocock/skills/write-a-prd
    skills add mattpocock/skills/tdd --mode=essential
    skills validate figma
    skills validate figma --mode=thorough
    skills audit
    skills check figma --report
    skills list
    skills remove write-a-prd

For more information on npx skills commands:
    npx skills --help
EOF
}

# =============================================================================
# 모드 선택 메뉴
# =============================================================================

select_validation_mode() {
    local mode="standard"  # 기본값

    # TTY 확인 (터미널인지 확인)
    if [ -t 0 ]; then
        # 대형 모드: 메뉴 표시
        echo ""
        echo -e "${CYAN}═══ VALIDATION MODE ═══${NC}"
        echo ""
        echo "  ${GREEN}1${NC}. Essential (15 patterns)  🚀 Fast"
        echo "     → Code execution, prompt injection, dangerous commands"
        echo ""
        echo "  ${YELLOW}2${NC}. Standard (29 patterns)   ⚡ Balanced ${GREEN}[RECOMMENDED]${NC}"
        echo "     → Essential + API keys, secrets, suspicious domains, obfuscation"
        echo ""
        echo "  ${BLUE}3${NC}. Thorough (58 patterns)   🛡️ Comprehensive"
        echo "     → Standard + personal data, IPs, all checks"
        echo ""
        echo -n "Choose ${CYAN}[1-3]${NC} (default: 2): " >&2

        read -r choice
        echo "" >&2

        case "$choice" in
            1|e|essential|E)
                mode="essential"
                echo -e "${GREEN}[→]${NC} Running Essential validation..." >&2
                ;;
            2|s|standard|S|"")
                mode="standard"
                echo -e "${YELLOW}[→]${NC} Running Standard validation..." >&2
                ;;
            3|t|thorough|T)
                mode="thorough"
                echo -e "${BLUE}[→]${NC} Running Thorough validation..." >&2
                ;;
            *)
                echo -e "${YELLOW}[!]${NC} Invalid choice. Defaulting to Standard." >&2
                mode="standard"
                echo -e "${YELLOW}[→]${NC} Running Standard validation..." >&2
                ;;
        esac
        echo "" >&2
    else
        # 비대형 모드 (LLM): 기본값 사용
        echo -e "${YELLOW}[→]${NC} Non-interactive mode: Using Standard validation" >&2
        echo "" >&2
    fi

    # 모드만 stdout으로 출력
    echo "$mode"
}

# =============================================================================
# 유효성 검사
# =============================================================================

check_validator() {
    if [ ! -f "$VALIDATOR" ]; then
        log_error "Skill validator not found at: $VALIDATOR"
        echo ""
        echo "Please install the skill validator first:"
        echo "  git clone https://github.com/hwanchoi/skill-validator ~/.claude/skill-validator"
        exit 1
    fi

    if [ ! -x "$VALIDATOR" ]; then
        chmod +x "$VALIDATOR"
    fi
}

parse_skill_spec() {
    local spec="$1"
    local repo=""
    local skill_path=""

    if [[ "$spec" =~ ^([^/]+)/([^/]+)/(.+)$ ]]; then
        repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
        skill_path="${BASH_REMATCH[3]}"
    elif [[ "$spec" =~ ^([^/]+)/(.+)$ ]]; then
        repo="mattpocock/skills"
        skill_path="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    else
        return 1
    fi

    printf '%s\t%s\n' "$repo" "$skill_path"
}

# =============================================================================
# 서브커맨드: add
# =============================================================================

cmd_add() {
    local skill_spec="$1"
    shift

    # 옵션 파싱
    local mode=""
    local skip_validation=false
    local force_install=false
    local mode_set=false
    local passthrough_args=()

    for arg in "$@"; do
        case "$arg" in
            --mode=*)
                mode="${arg#*=}"
                mode_set=true
                ;;
            --skip-validation)
                skip_validation=true
                ;;
            --force)
                force_install=true
                ;;
            *)
                passthrough_args+=("$arg")
                ;;
        esac
    done

    # --skip-validation 처리
    if [ "$skip_validation" = true ]; then
        log_warn "⚠️  Skipping security validation!"
        log_warn "This is dangerous and not recommended."
        echo ""
        # TTY가 아니면 확인 없이 진행
        if [ -t 0 ]; then
            read -p "Are you sure? (yes/no): " confirmation
            if [ "$confirmation" != "yes" ]; then
                echo "Cancelled."
                exit 1
            fi
        fi
        # 검증 스킵하고 바로 설치
        install_skill_and_bind_approval "$skill_spec" "${passthrough_args[@]}"
        exit $?
    fi

    # 검증기 실행
    check_validator

    echo ""
    echo -e "${CYAN}═══ SKILL VALIDATION ═══${NC}"
    echo ""
    log_info "Skill: ${skill_spec}"
    echo ""

    # 모드 결정 (--mode 옵션이 있으면 사용, 없으면 메뉴 표시)
    if [ "$mode_set" = true ]; then
        # 옵션으로 지정된 모드 사용
        case "$mode" in
            essential)
                echo -e "${GREEN}[→]${NC} Running Essential validation..."
                ;;
            standard)
                echo -e "${YELLOW}[→]${NC} Running Standard validation..."
                ;;
            thorough)
                echo -e "${BLUE}[→]${NC} Running Thorough validation..."
                ;;
            *)
                echo -e "${YELLOW}[!]${NC} Unknown mode: $mode, using Standard"
                mode="standard"
                echo -e "${YELLOW}[→]${NC} Running Standard validation..."
                ;;
        esac
        echo ""
    else
        # 옵션이 없으면 TTY 확인 후 메뉴 또는 기본값
        mode=$(select_validation_mode)
    fi

    # 검증기에 스킬 경로와 모드 전달
    if "$VALIDATOR" "$skill_spec" --mode="$mode"; then
        # 검증 통과: 실제 설치 실행
        echo ""
        log_info "✅ Validation passed! Installing skill..."
        echo ""
        install_skill_and_bind_approval "$skill_spec" "${passthrough_args[@]}"
        exit $?
    else
        # 검증 실패
        echo ""
        log_error "❌ Validation failed. Skill installation blocked."
        echo ""

        # --force 옵션이 있으면 강제 설치 확인
        if [ "$force_install" = true ]; then
            log_warn "⚠️  --force flag is set!"
            log_warn "Installing a skill that failed validation is dangerous."
            echo ""
            # TTY가 아니면 확인 없이 진행
            if [ -t 0 ]; then
                read -p "Do you want to force install anyway? (yes/no): " confirmation
                if [ "$confirmation" = "yes" ]; then
                    echo ""
                    log_warn "⚠️  Proceeding with force install..."
                    echo ""
                    install_skill_and_bind_approval "$skill_spec" "${passthrough_args[@]}"
                    exit $?
                else
                    echo "Cancelled."
                    exit 1
                fi
            else
                # 비대형 모드 (LLM)는 --force가 있으면 바로 진행
                log_warn "Non-interactive mode: Proceeding with force install..."
                echo ""
                install_skill_and_bind_approval "$skill_spec" "${passthrough_args[@]}"
                exit $?
            fi
        else
            echo ""
            echo "To bypass this protection (USE WITH CAUTION):"
            echo "  skills add $skill_spec --force"
            echo ""
            exit 1
        fi
    fi
}

# =============================================================================
# 서브커맨드: list, remove, update (검증 불필요)
# =============================================================================

sha256_hex() {
    local data="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$data" | sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$data" | shasum -a 256 | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        printf '%s' "$data" | openssl dgst -sha256 -r | awk '{print $1}'
    else
        log_error "No SHA-256 utility found (sha256sum, shasum, or openssl required)"
        return 1
    fi
}

file_mtime() {
    local target="$1"

    if stat -f %m "$target" >/dev/null 2>&1; then
        stat -f %m "$target"
    else
        stat -c %Y "$target"
    fi
}

trim_whitespace() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;?]*[ -/]*[@-~]//g'
}

canonicalize_json_file() {
    local json_file="$1"
    jq -Sc 'del(.signature)' "$json_file" 2>/dev/null
}

sign_approval_payload() {
    local payload="$1"
    local signing_key_file="$HOME/.claude/skill-approvals/.signing-key"

    [ -f "$signing_key_file" ] || return 1

    local signing_key
    signing_key=$(cat "$signing_key_file")

    if command -v openssl >/dev/null 2>&1; then
        printf '%s' "$payload" | openssl dgst -sha256 -hmac "$signing_key" | awk '{print $2}'
    else
        sha256_hex "${payload}${signing_key}"
    fi
}

verify_approval_signature() {
    local approval_file="$1"
    local signing_key_file="$HOME/.claude/skill-approvals/.signing-key"

    [ -f "$signing_key_file" ] || return 1

    local stored_signature
    stored_signature=$(jq -r '.signature // empty' "$approval_file" 2>/dev/null)
    [ -n "$stored_signature" ] || return 1

    local payload
    payload=$(canonicalize_json_file "$approval_file")
    [ -n "$payload" ] || return 1

    local signing_key
    signing_key=$(cat "$signing_key_file")

    local computed_signature
    if command -v openssl >/dev/null 2>&1; then
        computed_signature=$(printf '%s' "$payload" | openssl dgst -sha256 -hmac "$signing_key" | awk '{print $2}')
    else
        computed_signature=$(sha256_hex "${payload}${signing_key}")
    fi

    [ "$computed_signature" = "$stored_signature" ]
}

is_approval_fresh() {
    local approval_file="$1"
    local cache_time
    cache_time=$(file_mtime "$approval_file")

    local current_time
    current_time=$(date +%s)

    local cache_age=$(( (current_time - cache_time) / 86400 ))
    [ "$cache_age" -lt 30 ]
}

approval_skill_name() {
    local approval_file="$1"
    jq -r '.skill_name // (.skill_path | split("/") | last) // empty' "$approval_file" 2>/dev/null
}

approval_installed_path() {
    local approval_file="$1"
    jq -r '.installed_path // empty' "$approval_file" 2>/dev/null
}

parse_skills_output() {
    local output="$1"
    local line

    while IFS= read -r line; do
        line=$(printf '%s\n' "$line" | strip_ansi)
        line=$(trim_whitespace "$line")

        if [[ "$line" =~ ^([A-Za-z0-9._-]+)[[:space:]]+([~/].+)$ ]]; then
            local skill_name="${BASH_REMATCH[1]}"
            local skill_path
            skill_path=$(trim_whitespace "${BASH_REMATCH[2]}")
            skill_path=$(normalize_path "$skill_path")

            printf '%s\t%s\n' "$skill_name" "$skill_path"
        fi
    done <<< "$output"
}

list_installed_skills() {
    local roots=(
        "$HOME/.agents/skills"
        "$HOME/.claude/skills"
        "$HOME/.codex/skills"
        "$HOME/.skills"
    )
    local root
    local path

    for root in "${roots[@]}"; do
        [ -d "$root" ] || continue

        for path in "$root"/*; do
            [ -d "$path" ] || continue
            printf '%s\t%s\n' "$(basename "$path")" "$(normalize_path "$path")"
        done
    done

    local output
    output=$(run_skills_cli list 2>/dev/null || true)
    parse_skills_output "$output"

    output=$(run_skills_cli list -g 2>/dev/null || true)
    parse_skills_output "$output"
}

unique_skill_entries() {
    awk -F '\t' '!seen[$0]++'
}

list_installed_paths_for_skill_name() {
    local skill_name="$1"
    list_installed_skills | awk -F '\t' -v name="$skill_name" '$1 == name { print $2 }'
}

record_installed_path_for_skill_spec() {
    local skill_spec="$1"
    local before_paths="${2:-}"

    local parsed
    parsed=$(parse_skill_spec "$skill_spec") || return 0

    local repo="${parsed%%$'\t'*}"
    local skill_path="${parsed#*$'\t'}"
    local skill_name="${skill_path##*/}"
    local skill_hash
    skill_hash=$(sha256_hex "${repo}/${skill_path}")

    local approval_file="$HOME/.claude/skill-approvals/$skill_hash.json"
    [ -f "$approval_file" ] || return 0
    verify_approval_signature "$approval_file" || return 0

    local installed_path=""
    local candidate

    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        candidate=$(normalize_path "$candidate")

        if ! grep -Fxq "$candidate" <<< "$before_paths"; then
            installed_path="$candidate"
            break
        fi
    done < <(list_installed_paths_for_skill_name "$skill_name")

    if [ -z "$installed_path" ]; then
        local current_paths=()
        while IFS= read -r candidate; do
            [ -n "$candidate" ] || continue
            current_paths+=("$(normalize_path "$candidate")")
        done < <(list_installed_paths_for_skill_name "$skill_name")

        if [ ${#current_paths[@]} -eq 1 ]; then
            installed_path="${current_paths[0]}"
        else
            return 0
        fi
    fi

    local tmp_file="${approval_file}.tmp"
    jq --arg installed_path "$installed_path" \
       '. + {installed_path: $installed_path}' "$approval_file" > "$tmp_file" 2>/dev/null || {
        rm -f "$tmp_file"
        return 0
    }

    local payload
    payload=$(canonicalize_json_file "$tmp_file")
    [ -n "$payload" ] || {
        rm -f "$tmp_file"
        return 0
    }

    local signature
    signature=$(sign_approval_payload "$payload") || {
        rm -f "$tmp_file"
        return 0
    }

    jq --arg sig "$signature" '. + {signature: $sig}' "$tmp_file" > "${tmp_file}.signed" 2>/dev/null || {
        rm -f "$tmp_file" "${tmp_file}.signed"
        return 0
    }

    mv "${tmp_file}.signed" "$approval_file"
    rm -f "$tmp_file"
}

install_skill_and_bind_approval() {
    local skill_spec="$1"
    shift

    local parsed=""
    parsed=$(parse_skill_spec "$skill_spec" 2>/dev/null || true)

    local before_paths=""
    if [ -n "$parsed" ]; then
        local skill_path="${parsed#*$'\t'}"
        local skill_name="${skill_path##*/}"

        while IFS= read -r path; do
            [ -n "$path" ] || continue
            before_paths+=$(normalize_path "$path")
            before_paths+=$'\n'
        done < <(list_installed_paths_for_skill_name "$skill_name")
    fi

    run_skills_cli add "$skill_spec" "$@"
    local status=$?
    [ "$status" -eq 0 ] || return "$status"

    [ -n "$parsed" ] && record_installed_path_for_skill_spec "$skill_spec" "$before_paths"
    return 0
}

is_skill_validated() {
    local skill_name="$1"
    local skill_path="${2:-}"
    local approvals_dir="$HOME/.claude/skill-approvals"
    local approval_file
    local normalized_skill_path=""

    [ -n "$skill_path" ] && normalized_skill_path=$(normalize_path "$skill_path")

    [ -d "$approvals_dir" ] || return 1

    for approval_file in "$approvals_dir"/*.json; do
        [ -e "$approval_file" ] || continue
        verify_approval_signature "$approval_file" || continue
        is_approval_fresh "$approval_file" || continue

        local approved_path=""
        approved_path=$(approval_installed_path "$approval_file")

        if [ -n "$normalized_skill_path" ]; then
            if [ -n "$approved_path" ] && [ "$(normalize_path "$approved_path")" = "$normalized_skill_path" ]; then
                return 0
            fi
            continue
        fi

        if [ "$(approval_skill_name "$approval_file")" = "$skill_name" ]; then
            return 0
        fi
    done

    return 1
}

cmd_update() {
    check_validator

    echo ""
    echo -e "${CYAN}═══ SKILL UPDATE ═══${NC}"
    echo ""

    local validated_skills=()
    local unvalidated_skills=()
    local skill_entries=()
    local skill_entry

    while IFS= read -r skill_entry; do
        [ -n "$skill_entry" ] || continue
        skill_entries+=("$skill_entry")
    done < <(list_installed_skills | unique_skill_entries)

    if [ ${#skill_entries[@]} -eq 0 ]; then
        log_warn "No installed skills detected. Delegating to upstream 'skills update'..."
        echo ""
        run_skills_cli update "$@"
        exit $?
    fi

    for skill_entry in "${skill_entries[@]}"; do
        local skill_name="${skill_entry%%$'\t'*}"
        local skill_path="${skill_entry#*$'\t'}"
        if is_skill_validated "$skill_name" "$skill_path"; then
            validated_skills+=("${skill_name} (${skill_path})")
        else
            unvalidated_skills+=("${skill_name} (${skill_path})")
        fi
    done

    # 검증되지 않은 스킬이 있으면 경고
    if [ ${#unvalidated_skills[@]} -gt 0 ]; then
        log_warn "⚠️  The following skills were never validated or their cache expired:"
        echo ""
        for skill in "${unvalidated_skills[@]}"; do
            echo "  - $skill"
        done
        echo ""
        log_warn "Upstream 'skills update' updates all tracked skills."
        log_warn "This wrapper can warn, but it cannot selectively skip them yet."
        echo ""
    fi

    log_info "✅ Validation status checked for ${#skill_entries[@]} installed skill(s)."
    log_info "Delegating to upstream 'skills update'..."
    echo ""
    run_skills_cli update "$@"
    exit $?
}

cmd_passthrough() {
    run_skills_cli "$@"
    exit $?
}

# =============================================================================
# 서브커맨드: validate (설치된 스킬 검증)
# =============================================================================

cmd_validate() {
    check_validator

    if [ $# -lt 1 ]; then
        log_error "Usage: skills validate <skill-name> [--mode=essential|standard|thorough]"
        exit 1
    fi

    local skill_name="$1"
    shift

    # 옵션 파싱
    local mode="standard"

    for arg in "$@"; do
        case "$arg" in
            --mode=*)
                mode="${arg#*=}"
                ;;
        esac
    done

    # 검증기 실행 (로컬 모드)
    "$VALIDATOR" --local "$skill_name" --mode="$mode"
    exit $?
}

# =============================================================================
# 서브커맨드: audit (모든 설치된 스킬 검증)
# =============================================================================

cmd_audit() {
    check_validator

    echo ""
    echo -e "${CYAN}═══ SKILL AUDIT ═══${NC}"
    echo ""

    local skill_entries=()
    local skill_entry

    while IFS= read -r skill_entry; do
        [ -n "$skill_entry" ] || continue
        skill_entries+=("$skill_entry")
    done < <(list_installed_skills | unique_skill_entries)

    if [ ${#skill_entries[@]} -eq 0 ]; then
        log_warn "No skills installed"
        exit 0
    fi

    log_info "Found ${#skill_entries[@]} installed skills"
    echo ""

    # 각 스킬 검증
    local passed=0
    local failed=0
    local mode="standard"

    for skill_entry in "${skill_entries[@]}"; do
        local skill_name="${skill_entry%%$'\t'*}"
        local skill_path="${skill_entry#*$'\t'}"

        echo -e "${BLUE}Checking: ${skill_name} (${skill_path})${NC}"

        local validation_output
        if validation_output=$("$VALIDATOR" --local "$skill_path" --mode="$mode" 2>&1) \
            && grep -q "VALIDATION PASSED" <<< "$validation_output"; then
            echo -e "${GREEN}✓ PASS${NC}"
            ((passed++))
        else
            echo -e "${RED}✗ FAIL${NC}"
            if [ -n "${validation_output:-}" ]; then
                echo "$validation_output"
            fi
            ((failed++))
        fi
        echo ""
    done

    # 요약
    echo -e "${CYAN}═══ AUDIT SUMMARY ═══${NC}"
    echo ""
    echo -e "Total:   $((passed + failed))"
    echo -e "${GREEN}Passed:  $passed${NC}"
    echo -e "${RED}Failed:  $failed${NC}"
    echo ""

    if [ $failed -gt 0 ]; then
        exit 1
    fi

    exit 0
}

# =============================================================================
# 서브커맨드: check (상세 보고서)
# =============================================================================

cmd_check() {
    check_validator

    if [ $# -lt 1 ]; then
        log_error "Usage: skills check <skill-name> [--mode=essential|standard|thorough] [--report]"
        exit 1
    fi

    local skill_name="$1"
    shift

    # 옵션 파싱
    local mode="standard"
    local show_report=false

    for arg in "$@"; do
        case "$arg" in
            --mode=*)
                mode="${arg#*=}"
                ;;
            --report)
                show_report=true
                ;;
        esac
    done

    # 검증기 실행 (로컬 모드 + 상세 보고서)
    if [ "$show_report" = true ]; then
        "$VALIDATOR" --local "$skill_name" --mode="$mode" --report
    else
        "$VALIDATOR" --local "$skill_name" --mode="$mode"
    fi

    exit $?
}

# =============================================================================
# 메인
# =============================================================================

main() {
    # 인자 없으면 도움말
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    # 서브커맨드 추출
    local command="$1"
    shift || true

    case "$command" in
        help|--help|-h)
            show_help
            exit 0
            ;;
        add)
            if [ $# -lt 1 ]; then
                log_error "Usage: skills add <skill-path>"
                exit 1
            fi
            cmd_add "$@"
            ;;
        validate)
            if [ $# -lt 1 ]; then
                log_error "Usage: skills validate <skill-name>"
                exit 1
            fi
            cmd_validate "$@"
            ;;
        audit)
            cmd_audit "$@"
            ;;
        check)
            if [ $# -lt 1 ]; then
                log_error "Usage: skills check <skill-name>"
                exit 1
            fi
            cmd_check "$@"
            ;;
        list|remove|--version)
            # 검증 없이 바로 실행
            cmd_passthrough "$command" "$@"
            ;;
        update)
            # 업데이트 전 검증 상태를 점검
            cmd_update "$@"
            ;;
        *)
            # 알 수 없는 명령은 npx skills에 전달
            cmd_passthrough "$command" "$@"
            ;;
    esac
}

main "$@"
